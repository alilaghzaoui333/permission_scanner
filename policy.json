{
  "file_perm": "644",
  "dir_perm": "755",

  "secure_file_perm": "640",
  "secure_dir_perm": "750",

  "remove_world_write": true,
  "remove_setuid": true,
  "remove_setgid": true,

  "auto_fix": true,
  "log_changes": true,
  "generate_reports": true,
  "generate_signatures": true,

  "baseline_enabled": true,
  "snapshot_enabled": true,
  "drift_detection": true,
  "restore_from_baseline": true,

  "scan_hidden_files": true,
  "scan_sensitive_files": true,
  "recursive_scan": true,

  "max_risk_score": 100,

  "critical_paths": [
    "/etc",
    "/etc/shadow",
    "/etc/passwd",
    "/etc/sudoers",
    "/root",
    "/usr/bin",
    "/bin",
    "/sbin",
    "/boot"
  ],

  "sensitive_files": [
    "/etc/shadow",
    "/etc/passwd",
    "/etc/group",
    "/etc/gshadow",
    "/etc/sudoers",
    "/etc/ssh/sshd_config"
  ],

  "exceptions": [
    "/proc",
    "/sys",
    "/dev",
    "/run",
    "/snap",
    "/tmp",
    "/var/tmp",
    "./.git",
    "./logs",
    "./reports",
    "./signatures",
    "./baseline",
    "./test",
    "./scanner.sh",
    "./policy.json"
  ]
}